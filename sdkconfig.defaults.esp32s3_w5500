# Waveshare ESP32-S3-ETH: Ethernet uplink via external WIZnet W5500 (SPI).
# S3 has no built-in RMII EMAC, so this is a separate PHY path from the
# WT32-ETH01 (LAN8720) variant — don't chain this with sdkconfig.defaults.eth_common.
#
# Build with:
#   idf.py -B build_esp32s3_w5500 -D IDF_TARGET=esp32s3 \
#     -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.esp32s3;sdkconfig.defaults.esp32s3_w5500" \
#     build

# Use built-in USB_SERIAL_JTAG for console output (same as plain esp32s3 target)
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Ethernet uplink, SPI W5500 PHY path
CONFIG_ETH_UPLINK=y
CONFIG_ETH_PHY_SPI_W5500=y

# ESP-IDF esp_eth component: enable the SPI Ethernet / W5500 driver build
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# Waveshare ESP32-S3-ETH wiring (silkscreen / wiki defaults) — override per-board
# in menuconfig under "NAT Router Uplink" if you're on different hardware.
CONFIG_ETH_SPI_HOST=1
CONFIG_ETH_SPI_CLOCK_MHZ=20
CONFIG_ETH_SPI_MISO_GPIO=12
CONFIG_ETH_SPI_MOSI_GPIO=11
CONFIG_ETH_SPI_SCLK_GPIO=13
CONFIG_ETH_SPI_CS_GPIO=14
CONFIG_ETH_SPI_INT_GPIO=10
CONFIG_ETH_SPI_RST_GPIO=9
